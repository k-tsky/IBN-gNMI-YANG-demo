{
  "uid": "gnmi-demo",
  "title": "gNMI and YANG Push interface events",
  "schemaVersion": 40,
  "version": 5,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "containerlab",
    "gnmi",
    "yang-push"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Real gNMI and YANG Push ON_CHANGE",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Both receivers monitor **GigabitEthernet0/0/0/0**. Prometheus scrapes their latest received state every **1 second**.\n\n**1 = UP, 0 = DOWN** for this shutdown/restore demo. Very short transitions can be absent from the plot even when the receiver captured them; the CLI logs show the actual notifications. A successful scrape does not prove a healthy subscription.\n\nCounters cover the current run of each receiver agent, include initial state, and exclude lifecycle/sync-only messages. XRd can send several notifications for one interface transition; DOWN observations are not unique outages."
      }
    },
    {
      "id": 2,
      "title": "GigabitEthernet0/0/0/0 — last observed state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "B",
          "expr": "max(openconfig_interfaces_interfaces_interface_state_oper_status{job=\"gnmi\",interface_name=\"GigabitEthernet0/0/0/0\",oper_status=\"UP\"}) or (0 * max(openconfig_interfaces_interfaces_interface_state_oper_status{job=\"gnmi\",interface_name=\"GigabitEthernet0/0/0/0\"}))",
          "legendFormat": "gNMI ON_CHANGE",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1s"
        },
        {
          "refId": "C",
          "expr": "max(yang_push_interface_state{job=\"yang-push\",interface_name=\"GigabitEthernet0/0/0/0\"})",
          "legendFormat": "YANG Push ON_CHANGE",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gNMI ON_CHANGE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "YANG Push ON_CHANGE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Received DOWN observations",
      "description": "Received DOWN observations during the current run of each receiver agent. Initial/resync DOWN updates count. Several notifications can describe one interface transition.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "B",
          "expr": "sum(gnmic_file_output_number_messages_writes_total{job=\"gnmi-internal\",name=\"down-observations\"})",
          "legendFormat": "gNMI ON_CHANGE",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(yang_push_interface_down_observations_total{job=\"yang-push\",interface_name=\"GigabitEthernet0/0/0/0\"})",
          "legendFormat": "YANG Push ON_CHANGE",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gNMI ON_CHANGE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "YANG Push ON_CHANGE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Received gNMI / YANG Push observations",
      "description": "Received interface oper-status observations in the current run of each receiver agent. Includes initial state and repeated reports; excludes lifecycle/sync-only messages. Counters reset when the corresponding agent restarts.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "B",
          "expr": "sum(gnmic_file_output_number_messages_writes_total{job=\"gnmi-internal\",name=\"observations\"})",
          "legendFormat": "gNMI ON_CHANGE",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(yang_push_interface_observations_total{job=\"yang-push\",interface_name=\"GigabitEthernet0/0/0/0\"})",
          "legendFormat": "YANG Push ON_CHANGE",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gNMI ON_CHANGE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "YANG Push ON_CHANGE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "gNMI last state",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(openconfig_interfaces_interfaces_interface_state_oper_status{job=\"gnmi\",interface_name=\"GigabitEthernet0/0/0/0\",oper_status=\"UP\"}) or (0 * max(openconfig_interfaces_interfaces_interface_state_oper_status{job=\"gnmi\",interface_name=\"GigabitEthernet0/0/0/0\"}))",
