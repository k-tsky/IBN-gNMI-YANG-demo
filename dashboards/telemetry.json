{
  "uid": "gnmi-demo",
  "title": "SNMP polling | gNMI ON_CHANGE",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "containerlab",
    "gnmi",
    "snmp"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Same interface: SNMP polling vs gNMI ON_CHANGE",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "demo_interface_up",
          "legendFormat": "{{method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 8,
            "showPoints": "always"
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "poll"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "SNMP polling"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stream"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "gNMI ON_CHANGE"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "1 = UP; 0 = DOWN. Last observed state from SNMP polling and gNMI ON_CHANGE. Consult collector health and observation age. Prometheus samples every second."
    },
    {
      "id": 2,
      "title": "Observed DOWN events",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "demo_down_events_total",
          "legendFormat": "{{method}}",
          "datasource": {
            "type": "prometheus",
