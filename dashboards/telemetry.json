      "targets": [
        {
          "refId": "A",
          "expr": "openconfig_interfaces_interfaces_interface_state_oper_status{job=\"gnmi\",interface_name=\"GigabitEthernet0/0/0/0\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1s",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
