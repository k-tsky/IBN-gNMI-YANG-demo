      }
    },
    {
      "id": 4,
      "title": "gNMI last state",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 18,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(srl_nokia_interfaces_interface_oper_state{job=\"gnmi\",interface_name=\"ethernet-1/1\",oper_state=\"up\"}) or (0 * max(srl_nokia_interfaces_interface_oper_state{job=\"gnmi\",interface_name=\"ethernet-1/1\"}))",
          "legendFormat": "gNMI",
          "datasource": {
            "type": "prometheus",
